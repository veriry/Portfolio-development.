<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Основные фоны -->
    <SolidColorBrush x:Key="PrimaryBackground" Color="#1A1A1A" />
    <SolidColorBrush x:Key="SecondaryBackground" Color="#2D2D2D" />

    <!-- Цвета меню -->
    <SolidColorBrush x:Key="SidebarItemBackground" Color="Transparent" />
    <SolidColorBrush x:Key="SidebarItemHoverBackground" Color="#3D3D3D" />
    <SolidColorBrush x:Key="SidebarItemSelectedBackground" Color="#383838" />

    <!-- Текст -->
    <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryText" Color="#B0B0B0" />

    <!-- Акцентный цвет -->
    <SolidColorBrush x:Key="AccentColor" Color="#C8A45D" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#D9B574" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#B8924D" />

    <!-- Границы -->
    <SolidColorBrush x:Key="BorderColor" Color="#404040" />
    <SolidColorBrush x:Key="SeparatorColor" Color="#3D3D3D" />

    <!-- Поля ввода -->
    <SolidColorBrush x:Key="BgInput" Color="#3D3D3D" />

    <!-- Конвертеры -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

</ResourceDictionary>